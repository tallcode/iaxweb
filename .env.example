HOST=0.0.0.0
PORT=3000
# 本机直接运行使用 127.0.0.1；Docker Desktop Compose 访问宿主机时改为 host.docker.internal。
NATS_SERVERS=nats://127.0.0.1:4222
NATS_SUBJECT_ROOT=iaxmon.nodes

# Gateway 每 15 秒按节点上报当前 /audio WebSocket 数量，无需额外配置。

ALLMON3_BASE_URL=http://172.16.211.199/allmon3/
ALLMON3_REFRESH_INTERVAL_MS=30000
ALLMON3_REQUEST_TIMEOUT_MS=10000

# Choose either username/password or token authentication.
# NATS_USERNAME=iaxweb
# NATS_PASSWORD=change-me
# NATS_TOKEN=change-me

# AI 值机员：在 config/nodes.json 中为节点配置 "AI": true 启用（该节点须同时 AUDIO: true）。
# 语音识别（ASR）与大语言模型（LLM）的接口配置完全独立，可使用不同供应商。
# Compose 挂载 data/ 时使用的容器 UID/GID；Linux 可用 `id -u` / `id -g` 获取。
# PUID=1000
# PGID=1000

# --- 语音识别（ASR，DashScope 同步接口）---
# 任一节点启用 AI 时必须提供 ASR Key。旧的 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL
# 仍可作为 ASR 的兼容别名；LLM 不会读取它们。
# AI_ASR_API_KEY=sk-xxxx
# AI_ASR_BASE_URL=https://dashscope.aliyuncs.com
# AI_ASR_MODEL=qwen-audio-3.1-asr-flash
# 段长规则：冷启动（AI_ACTIVITY_WINDOW_MS 内无语音）丢弃不足 AI_COLD_MIN_SEGMENT_MS 的段，
# 热启动丢弃不足 AI_HOT_MIN_SEGMENT_MS 的段，超过 AI_MAX_SEGMENT_MS 分段
# AI_COLD_MIN_SEGMENT_MS=5000
# AI_HOT_MIN_SEGMENT_MS=2000
# AI_ACTIVITY_WINDOW_MS=30000
# AI_MAX_SEGMENT_MS=120000
# 上下文窗口：最近多久的识别结果作为下次识别的上下文
# AI_CONTEXT_WINDOW_MS=300000

# --- 大语言模型（LLM，OpenAI 兼容接口）---
# base URL 需包含版本前缀，客户端会追加 /chat/completions。例如：
#   DeepSeek: https://api.deepseek.com/v1
#   OpenAI:   https://api.openai.com/v1
#   百炼:      https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_LLM_API_KEY=sk-xxxx
# AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_LLM_MODEL=qwen3.7-flash
# AI_LLM_ENABLED=true
# 识别到呼号时是否发布到 AI Spot 面板（false 只记日志，不发布呼号）
# AI_LLM_PUBLISH_SPOT=true
# 思考模式：留空时 qwen* 模型默认 false，其他模型不发送该字段。
# 注意：LLM 使用 response_format=json_object（DeepSeek JSON Output）；返回非 JSON 或不符合 schema 时自动忽略。
# AI_LLM_ENABLE_THINKING=false
# AI_LLM_THINKING_BUDGET=1024
# AI_LLM_TIMEOUT_MS=30000
# AI_LLM_PROMPT_FILE=config/prompt.txt
# AI_LLM_SCHEMA_FILE=config/schema.json

# --- 持久化与人工复核 ---
# 是否写入 SQLite 及保存 WAV 录音；关闭后只进行实时识别
# AI_PERSISTENCE_ENABLED=false
# SQLite 持久化文件；相对路径从项目根目录解析
# AI_DATABASE_FILE=data/ai.sqlite
# 录音目录；默认在 SQLite 所在目录下的 rec/
# AI_RECORDINGS_DIR=data/rec
# 管理账号文件；仅在开启持久化时读取
# AI_ADMIN_FILE=config/admin.json
# AI_SESSIONS_FILE=data/sessions.json

# --- ASR 文件与呼号提示 ---
# AI_HOTWORDS_FILE=config/hotwords.json
# AI_BACKGROUND_FILE=config/background.txt
# 常见呼号相似度候选默认关闭；呼号表每行一个，保存后立即生效
# AI_CALLSIGN_HINTS_ENABLED=false
# AI_CALLSIGNS_FILE=config/callsigns.txt
