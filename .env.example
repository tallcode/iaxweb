HOST=0.0.0.0
PORT=3000
NATS_SERVERS=nats://127.0.0.1:4222
NATS_SUBJECT_ROOT=iaxmon.nodes

# Gateway 每 15 秒按节点上报当前 /audio WebSocket 数量，无需额外配置。

ALLMON3_BASE_URL=http://172.16.211.199/allmon3/
ALLMON3_REFRESH_INTERVAL_MS=30000
ALLMON3_REQUEST_TIMEOUT_MS=10000

# Choose either username/password or token authentication.
# NATS_USERNAME=iaxweb
# NATS_PASSWORD=change-me
# NATS_TOKEN=change-me

# AI 值机员：在 nodes.json 中为节点配置 "AI": true 启用（该节点须同时 AUDIO: true）。
# 启用后必须提供百炼 API Key。
# DASHSCOPE_API_KEY=sk-xxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# AI_ASR_MODEL=qwen-audio-3.0-asr-flash
# 段长规则：冷启动（AI_ACTIVITY_WINDOW_MS 内无语音）丢弃不足 AI_COLD_MIN_SEGMENT_MS 的段，
# 热启动丢弃不足 AI_HOT_MIN_SEGMENT_MS 的段，超过 AI_MAX_SEGMENT_MS 分段
# AI_COLD_MIN_SEGMENT_MS=5000
# AI_HOT_MIN_SEGMENT_MS=2000
# AI_ACTIVITY_WINDOW_MS=30000
# AI_MAX_SEGMENT_MS=120000
# 上下文窗口：最近多久的识别结果作为下次识别的上下文
# AI_CONTEXT_WINDOW_MS=300000
# AI_HOTWORDS_FILE=ai/hotwords.json
# AI_BACKGROUND_FILE=ai/background.txt
# AI_LLM_ENABLED=true
# AI_LLM_MODEL=qwen3.7-flash
# 识别到呼号时是否发布到 AI Spot 面板（false 只记日志，不发布呼号）
# AI_LLM_PUBLISH_SPOT=true
# 思考模式默认关闭（关闭时快、不易超时）；开启时可用 thinking_budget 限制思考量
# AI_LLM_ENABLE_THINKING=false
# AI_LLM_THINKING_BUDGET=1024
# AI_LLM_TIMEOUT_MS=30000
# AI_LLM_PROMPT_FILE=ai/prompt.txt
# AI_LLM_SCHEMA_FILE=ai/schema.json
# 常见呼号相似度候选默认关闭；呼号表每行一个，保存后立即生效
# AI_CALLSIGN_HINTS_ENABLED=false
# AI_CALLSIGNS_FILE=ai/callsigns.txt
