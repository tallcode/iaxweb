{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "quote",
        "callsign",
        "evidence"
      ],
      "properties": {
        "speaker": {
          "const": "self"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "callsign": {
          "type": "string",
          "pattern": "^B[ADGHIY][0-9][A-Z]{2,3}$"
        },
        "evidence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker"
      ],
      "properties": {
        "speaker": {
          "enum": [
            "other",
            "unknown"
          ]
        }
      }
    }
  ]
}
