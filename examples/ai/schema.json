{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "callsign",
        "speakerEvidence",
        "callsignEvidence"
      ],
      "properties": {
        "speaker": {
          "const": "self"
        },
        "callsign": {
          "type": "string",
          "pattern": "^B[ADGHIY][0-9][A-Z]{2,3}$"
        },
        "speakerEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/textEvidence"
            },
            {
              "$ref": "#/$defs/featureMatchEvidence"
            }
          ]
        },
        "callsignEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/spellingEvidence"
            },
            {
              "$ref": "#/$defs/featureMatchEvidence"
            }
          ]
        },
        "message": {
          "description": "规范化后的信息文本",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker"
      ],
      "properties": {
        "speaker": {
          "enum": [
            "other",
            "unknown"
          ]
        },
        "message": {
          "description": "规范化后的信息文本",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        }
      }
    }
  ],
  "$defs": {
    "textEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "quote"
      ],
      "properties": {
        "source": {
          "const": "text"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spellingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "candidateId"
      ],
      "properties": {
        "source": {
          "const": "spelling"
        },
        "candidateId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "featureMatchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "matchId"
      ],
      "properties": {
        "source": {
          "const": "featureMatch"
        },
        "matchId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "risk": {
      "additionalProperties": false,
      "description": "风控评级",
      "properties": {
        "level": {
          "description": "风控等级 1~5，5 最严重",
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "description": "风控原因，中文 20 字以内",
          "type": "string"
        }
      },
      "required": [
        "level",
        "reason"
      ],
      "type": "object"
    }
  }
}
