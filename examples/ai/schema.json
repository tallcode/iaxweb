{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selfCallsignEvidence",
    "spelledCallsignEvidence",
    "selfCallsign",
    "spelledCallsigns"
  ],
  "properties": {
    "selfCallsignEvidence": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "spelledCallsignEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "callsign"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "callsign": {
            "type": "string",
            "pattern": "^B[ABDEGHIY][0-9][A-Z]{2,3}$"
          }
        }
      }
    },
    "selfCallsign": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9]{2,8}$"
    },
    "spelledCallsigns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^B[ABDEGHIY][0-9][A-Z]{2,3}$"
      }
    }
  }
}
