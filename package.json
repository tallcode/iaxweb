{
  "name": "iaxweb",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @iaxweb/frontend",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @iaxweb/backend",
    "dev:frontend": "npm run dev --workspace @iaxweb/frontend",
    "start": "npm run start --workspace @iaxweb/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "phonetic-corrector-test": "npm run phonetic-corrector-test --workspace @iaxweb/backend --",
    "llm-parse-test": "npm run llm-parse-test --workspace @iaxweb/backend --",
    "callsign-match-test": "npm run callsign-match-test --workspace @iaxweb/backend --",
    "hash-admin-password": "npm run hash-admin-password --workspace @iaxweb/backend --"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1"
  }
}
